# Chave da OpenRouter (obrigatória para o chat responder)
OPENROUTER_API_KEY=

# Modelo principal e o de reserva (qualquer modelo da OpenRouter com tool calling)
LLM_MODELO=anthropic/claude-haiku-5.5
LLM_MODELO_RESERVA=deepseek/deepseek-v4.1-flash

# Catálogo de produtos
DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_TIMEOUT_MS=5000

# Porta do chat na sua máquina
PORTA=8080
