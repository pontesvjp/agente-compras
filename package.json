{
  "name": "agente-compras",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/chat",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:teste": "docker run -d --rm --name compras-pg-teste -p 5433:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=compras_teste postgres:17-alpine"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
