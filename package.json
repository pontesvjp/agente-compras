    "format": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
